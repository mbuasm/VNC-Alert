<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>MaszynyAlert.Probe</RootNamespace>
    <AssemblyName>probe</AssemblyName>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <Description>Narzędzie rozpoznawcze: wersja RFB, typy zabezpieczeń, zrzuty ekranu, test OCR, test UDP.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testy jednostkowe (tests/MaszynyAlert.Probe.Tests) sprawdzają też typy wewnętrzne narzędzia:
         SimpleTable (wyrównywanie kolumn tabeli) i HostPortArg (rozbiór "adres:port" oraz opcji roi). -->
    <InternalsVisibleTo Include="MaszynyAlert.Probe.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MaszynyAlert.Core\MaszynyAlert.Core.csproj" />
    <ProjectReference Include="..\MaszynyAlert.Windows\MaszynyAlert.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\config\config.example.json" Link="config.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\rules.example.json" Link="rules.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
