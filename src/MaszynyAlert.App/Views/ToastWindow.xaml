<Window Style="{StaticResource {x:Type Window}}" x:Class="MaszynyAlert.App.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VNC Alert"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Background="Transparent">
    <Grid x:Name="Stage" ClipToBounds="True">
    <Border x:Name="Card"
            Margin="14,14,14,28"
            Opacity="0"
            MinWidth="240"
            MaxWidth="440"
            CornerRadius="14"
            Padding="14,11,20,11"
            BorderThickness="1"
            Background="{DynamicResource CardBackgroundBrush}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.28" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="28" Height="28" VerticalAlignment="Center">
                <Ellipse x:Name="IconCircle" />
                <Path x:Name="IconGlyph"
                      StrokeThickness="2.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="DetailText"
                           FontSize="12.5"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
