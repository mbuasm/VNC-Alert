<Window Style="{StaticResource {x:Type Window}}" x:Class="MaszynyAlert.App.Views.OperatorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="VNC Alert — Podgląd" Icon="/Assets/VncAlert.ico" Width="1100" Height="780" MinWidth="740" MinHeight="520"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource PanelBackgroundBrush}">
 <DockPanel Margin="28">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,24">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="VNC Alert" FontSize="30" FontWeight="Bold"/>
    <TextBlock Text="Podgląd • stanowisko produkcyjne" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,4,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="ThemeButton" Content="Tryb ciemny" Click="Theme_Click" Margin="0,0,10,0"
            ToolTip="Przełącza wygląd wszystkich okien VNC Alert między jasnym a ciemnym (tylko ten komputer)"/>
    <Button Content="Panel administracyjny" Click="Admin_Click"/>
   </StackPanel>
  </Grid>
  <TextBlock DockPanel.Dock="Bottom" x:Name="VersionLabel" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,14,0,0"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <Border CornerRadius="16" Background="{DynamicResource OkSoftBackgroundBrush}" Padding="20" Margin="0,0,0,24">
     <StackPanel><TextBlock x:Name="Summary" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock x:Name="SummaryDetail" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
    </Border>
    <TextBlock Text="Maszyny" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
    <ItemsControl x:Name="MachineCards">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <!-- Wyróżnienie karty: maszyna wskazana kliknięciem kafelka nakładki statusu. -->
      <Border Width="235" MinHeight="158" Padding="16" Margin="0,0,14,14">
       <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
         <Style.Triggers>
          <DataTrigger Binding="{Binding Highlighted}" Value="True">
           <Setter Property="BorderBrush" Value="{Binding Accent}"/>
           <Setter Property="BorderThickness" Value="2"/>
           <Setter Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Border.Style>
       <StackPanel>
        <DockPanel><TextBlock Text="{Binding Symbol}" Style="{StaticResource MachineStateTextStyle}" FontSize="19" DockPanel.Dock="Right"/>
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="19"/></DockPanel>
        <TextBlock Text="{Binding State}" Style="{StaticResource MachineStateTextStyle}" FontWeight="SemiBold" Margin="0,12,0,5"/>
        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MinHeight="38"/>
        <Button Content="Pokaż ekran" Tag="{Binding Id}" Click="Screen_Click" Padding="10,6" HorizontalAlignment="Left" Margin="0,8,0,0"/>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="Maszyny bez pracy" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,12"/>
    <TextBlock x:Name="NoIdle" Text="Wszystkie maszyny mają pracę." Foreground="{DynamicResource TextSecondaryBrush}"/>
    <!-- Zasięg „✕ Skasuj” — czy zgaśnie także na pozostałych komputerach grupy (AppOrchestrator.DismissScopeNote). -->
    <TextBlock x:Name="IdleScope" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12"/>
    <ItemsControl x:Name="IdleCards">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource CardStyle}" BorderBrush="{DynamicResource WarningSoftBorderBrush}" Margin="0,0,0,12">
       <DockPanel>
        <Button DockPanel.Dock="Right" Content="✕ Skasuj" Command="{Binding DismissCommand}" Margin="16,0,0,0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Line1}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
       </DockPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="Do sprawdzenia" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,12"/>
    <TextBlock x:Name="NoAlerts" Text="Brak alertów do potwierdzenia." Foreground="{DynamicResource TextSecondaryBrush}"/>
    <ItemsControl x:Name="AlertCards">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource CardStyle}" BorderBrush="{DynamicResource ErrorSoftBorderBrush}" Margin="0,0,0,12">
       <StackPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="Idę sprawdzić" Command="{Binding AcknowledgeCommand}" Margin="16,0,0,0"/>
         <TextBlock Text="{Binding Line1}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
        <Expander Header="Jak rozwiązać ten problem?" Margin="0,14,0,0">
         <TextBlock Text="{Binding Solution}" TextWrapping="Wrap" Margin="0,12,0,4" LineHeight="23"/>
        </Expander>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
