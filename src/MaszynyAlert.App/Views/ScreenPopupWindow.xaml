<Window Style="{StaticResource {x:Type Window}}" x:Class="MaszynyAlert.App.Views.ScreenPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VNC Alert — włącz okno podglądu stanu maszyny"
        Width="460"
        SizeToContent="Height"
        MaxHeight="500"
        WindowStartupLocation="Manual"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Transparent">
    <Border BorderBrush="{DynamicResource WarningYellowBrush}" BorderThickness="2" CornerRadius="28" Background="{DynamicResource WindowBackgroundBrush}" Padding="8">
        <DockPanel>
            <!-- Nagłówek bursztynowy (NIE czerwień błędu — to przypomnienie organizacyjne, nie awaria maszyny).
                 "✕" w nagłówku zamyka WSZYSTKIE pokazane powiadomienia (ACK) — patrz code-behind. -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource WarningYellowBrush}" CornerRadius="20" Padding="12,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            x:Name="CloseButton"
                            Content="✕"
                            Click="CloseButton_Click"
                            Width="26" Height="26"
                            Padding="0"
                            FontWeight="Bold"
                            Foreground="#3A2C00"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Zamknij wszystkie pokazane powiadomienia" />
                    <TextBlock Text="WŁĄCZ OKNO PODGLĄDU STANU MASZYNY"
                               FontSize="15" FontWeight="Bold"
                               Foreground="#3A2C00"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <TextBlock DockPanel.Dock="Top"
                       Text="Na pulpicie maszyny (VNC) jest włączona inna zakładka niż okno stanu maszyny — to z alertami i procentem („Milling Status”). Dopóki tak jest, program NIE widzi błędów tej maszyny. Przełącz HMI z powrotem na okno stanu maszyny."
                       Foreground="#DDDDDD"
                       FontSize="12"
                       Margin="12,10,12,4"
                       TextWrapping="Wrap" />

            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" MaxHeight="380">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}"
                                  Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="12,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="✕ Zamknij"
                                                Command="{Binding DismissCommand}"
                                                Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Line1}"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Widoczne tylko w trybie przypiętym (w trybie zwykłym okno jest wtedy chowane, patrz code-behind). -->
                    <TextBlock Text="Wszystkie maszyny pokazują ekran główny"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                               Foreground="#BBBBBB"
                               Margin="16,14"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
