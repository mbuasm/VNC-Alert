<Window Style="{StaticResource {x:Type Window}}" x:Class="MaszynyAlert.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VNC Alert — nakładka statusu"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Transparent">
    <Window.Resources>
        <Style x:Key="OverlayMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="8,6,12,6" Cursor="Hand">
                            <DockPanel>
                                <TextBlock x:Name="Check" Text="✓" Width="18" FontWeight="Bold" DockPanel.Dock="Left"
                                           Foreground="{DynamicResource AccentBrush}" Visibility="Hidden" VerticalAlignment="Center" />
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="6,6,6,1">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <StackPanel Orientation="Horizontal">
            <!-- Lewa kolumna: uchwyt do przeciągania, a pod nim przycisk układu kafelków. -->
            <StackPanel Margin="0,0,6,5" VerticalAlignment="Top">
                <!-- Uchwyt do przeciągania: cała nakładka jest klikalna (kafelek otwiera Podgląd), więc
                     przeciąganie ma własne, jednoznaczne miejsce. -->
                <Border x:Name="DragHandle"
                        MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                        Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="10" Padding="7,6"
                        Cursor="SizeAll"
                        ToolTip="Przeciągnij, żeby przesunąć nakładkę">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="⠿" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="VNC" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Button x:Name="LayoutButton" Click="LayoutButton_Click" Margin="0,5,0,0" Padding="0"
                        Cursor="Hand" ToolTip="Układ kafelków" Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Face" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="10" Padding="7,5">
                                <TextBlock Text="⊞" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="LayoutMenu" Placement="Right" HasDropShadow="False"
                                     ItemContainerStyle="{StaticResource OverlayMenuItemStyle}">
                            <ContextMenu.Template>
                                <ControlTemplate TargetType="ContextMenu">
                                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="4" Margin="4,0,0,0">
                                        <StackPanel IsItemsHost="True" />
                                    </Border>
                                </ControlTemplate>
                            </ContextMenu.Template>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>

            <ItemsControl x:Name="Tiles">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="{Binding Id}" Click="Tile_Click" Cursor="Hand"
                                ToolTip="{Binding Detail}" Margin="0,0,5,5" Padding="0" VerticalAlignment="Top"
                                BorderThickness="0" Background="Transparent">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="Surface" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{Binding Accent}"
                                                BorderThickness="1,1,1,3" CornerRadius="10" Padding="9,6" Width="132">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Symbol}" Style="{StaticResource MachineStateTextStyle}"
                                                               FontSize="13" FontWeight="Bold" DockPanel.Dock="Right" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding ShortState}" Style="{StaticResource MachineStateTextStyle}"
                                                           FontWeight="SemiBold" FontSize="12" Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Progress}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                                           Margin="0,1,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <!-- Miganie czerwonego kafelka: osobna warstwa nad kafelkiem, żeby nie
                                             ruszać kolorów przychodzących z MachineCardViewModel. -->
                                        <Border x:Name="Blink" CornerRadius="10" Background="{DynamicResource AlertRedBrush}" Opacity="0"
                                                IsHitTestVisible="False" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Alarming}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="BlinkStoryboard">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Blink"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="0.32" Duration="0:0:0.6"
                                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="BlinkStoryboard" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- „✕” chowa nakładkę i zapamiętuje ten wybór; z powrotem włącza ją menu zasobnika. -->
            <Button x:Name="HideButton" Content="✕" Click="HideButton_Click"
                    Width="24" Height="24" Padding="0" Margin="1,0,0,0"
                    VerticalAlignment="Top" FontWeight="Bold"
                    ToolTip="Ukryj nakładkę (menu zasobnika → Nakładka statusu)" />
        </StackPanel>
    </Border>
</Window>
