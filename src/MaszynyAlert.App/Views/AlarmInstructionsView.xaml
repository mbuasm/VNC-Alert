<UserControl x:Class="MaszynyAlert.App.Views.AlarmInstructionsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="Instrukcje naprawy błędów" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="Edytuj pomoc „Jak rozwiązać ten problem?”. Zapis działa od razu przy tym błędzie na wszystkich maszynach." TextWrapping="Wrap" Margin="0,6,0,0"/>
   <TextBlock x:Name="GroupStatusText" Text="{Binding GroupStatus}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource AccentBrush}"/>
  </StackPanel>
  <Grid Grid.Row="1" IsEnabled="{Binding CanEdit}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1*" MinWidth="210"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <DockPanel Margin="0,0,20,0">
    <StackPanel DockPanel.Dock="Top">
     <Label Content="Szukaj numeru lub nazwy błędu" Target="{Binding ElementName=SearchBox}"/>
     <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,12"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
     <Label Content="Numer spoza słownika" Target="{Binding ElementName=NewCodeBox}"/>
     <DockPanel><Button Content="Dodaj" Command="{Binding AddCodeCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
      <TextBox x:Name="NewCodeBox" Text="{Binding NewCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Padding="8"/></DockPanel>
    </StackPanel>
    <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
   </DockPanel>
   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding Selected.Label}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <Label Grid.Row="1" Content="Instrukcja dla operatora (do 4000 znaków)" Target="{Binding ElementName=InstructionText}"/>
    <TextBox Grid.Row="2" x:Name="InstructionText" Text="{Binding Selected.Text, UpdateSourceTrigger=PropertyChanged}"
     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000" Padding="14" FontSize="15"/>
    <StackPanel Grid.Row="3" Margin="0,8">
     <TextBlock Text="{Binding Selected.DraftStatus}" Foreground="{DynamicResource TextSecondaryBrush}"/>
     <TextBlock x:Name="LastChangeText" Text="{Binding Selected.LastChange}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
    </StackPanel>
    <WrapPanel Grid.Row="4">
     <Button Content="Zapisz instrukcję" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,6"/>
     <Button Content="Przywróć domyślną" Command="{Binding RestoreCommand}" Margin="0,0,0,6"/>
    </WrapPanel>
   </Grid>
  </Grid>
  <TextBlock Grid.Row="2" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
 </Grid>
</UserControl>
