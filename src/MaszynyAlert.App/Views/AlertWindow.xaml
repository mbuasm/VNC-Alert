<Window Style="{StaticResource {x:Type Window}}" x:Class="MaszynyAlert.App.Views.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VNC Alert — UWAGA, błąd maszyny"
        Width="460"
        SizeToContent="Height"
        MaxHeight="620"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave"
        Background="Transparent">
    <Border BorderBrush="{DynamicResource ErrorBorderBrush}" BorderThickness="2" CornerRadius="28" Background="{DynamicResource ErrorSoftBackgroundBrush}" Padding="8">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource ErrorBandBrush}" CornerRadius="20" Padding="16,12"
                    Cursor="SizeAll" ToolTip="Przeciągnij, żeby przesunąć okno"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="!   VNC Alert • Błąd maszyny" Foreground="{DynamicResource ErrorTextBrush}" FontSize="16" FontWeight="SemiBold" />
            </Border>

            <ScrollViewer x:Name="AlertsScroll" DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" MaxHeight="530">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource ErrorSoftBorderBrush}" BorderThickness="0,0,0,1" Padding="16,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Line1}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Line2}"
                                               Visibility="{Binding Line2, Converter={StaticResource NullToVisibility}}"
                                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding StatusText}"
                                               Visibility="{Binding StatusText, Converter={StaticResource NullToVisibility}}"
                                               FontSize="13" Foreground="{DynamicResource WarningTextBrush}" Margin="0,4,0,0" />
                                    <!-- Expanded: po rozwinięciu okno rośnie w dół, więc code-behind podnosi je
                                         nad dolną krawędź ekranu i przewija do instrukcji. -->
                                    <Expander Header="Jak rozwiązać ten problem?" Foreground="{DynamicResource ErrorTextBrush}" Margin="0,14,0,0"
                                              IsExpanded="{Binding IsHelpExpanded, Mode=TwoWay}"
                                              Expanded="Solution_Expanded">
                                        <TextBlock Text="{Binding Solution}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,4"/>
                                    </Expander>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Idę sprawdzić"
                                                Style="{StaticResource AcknowledgeButtonStyle}"
                                                Command="{Binding AcknowledgeCommand}"
                                                HorizontalAlignment="Left"
                                                MinWidth="150" />
                                        <Button Content="Pokaż zrzut"
                                                Command="{Binding OpenCaptureCommand}"
                                                Visibility="{Binding HasCapture, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="Otwiera zrzut wycinka paska statusu zapisany przy wykryciu tego błędu (na tym komputerze)"
                                                Padding="10,4"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
