<Window Style="{StaticResource {x:Type Window}}" x:Class="MaszynyAlert.App.Views.IdlePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VNC Alert — dołóż prace"
        Width="420"
        SizeToContent="Height"
        MaxHeight="500"
        WindowStartupLocation="Manual"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Transparent">
    <Border BorderBrush="{DynamicResource WarningYellowBrush}" BorderThickness="2" CornerRadius="28" Background="{DynamicResource WarningSoftBackgroundBrush}" Padding="8">
        <DockPanel>
            <!-- Nagłówek bursztynowy (NIE czerwień błędu — to przypomnienie, nie awaria) — "✕" chowa lokalnie
                 (tryb zwykły) albo chowa i odpina (tryb przypięty), nigdy nie kasuje alertu (patrz code-behind). -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource WarningBandBrush}" CornerRadius="20" Padding="14,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            x:Name="CloseButton"
                            Content="✕"
                            Click="CloseButton_Click"
                            Width="26" Height="26"
                            Padding="0"
                            FontWeight="Bold"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Chowa to okno TYLKO na tym komputerze — powiadomienie zostaje (skasuj je przyciskiem przy maszynie)" />
                    <TextBlock Text="VNC Alert • Dołóż prace"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource WarningTextBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}"
                                  Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource WarningSoftBorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="Gotowe"
                                                Command="{Binding DismissCommand}"
                                                ToolTip="{Binding DismissHint}"
                                                Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Line1}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Zasięg przycisku "Gotowe": czy zgasi powiadomienie także na pozostałych komputerach grupy,
                         czy tylko tutaj (AppOrchestrator.DismissScopeNote). Widoczne razem z listą — przy pustej
                         liście nie ma czego kasować. Ostrzeżenie (brak grupy / nie widać innego komputera) jest
                         w mocniejszym kolorze. -->
                    <TextBlock Text="{Binding ScopeNote}"
                               Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}"
                               FontSize="12"
                               Margin="14,10,14,12"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScopeWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Widoczne tylko w trybie przypiętym (w trybie zwykłym okno jest wtedy chowane, patrz code-behind). -->
                    <TextBlock Text="Brak maszyn stojących bez pracy"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="16,14"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
