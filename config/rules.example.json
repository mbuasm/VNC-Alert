      // ---- Sekcja "rules" ------------------------------------------------------------------------------
      // Reguły na TREŚCI komunikatu – ścieżka zapasowa, gdy numeru alarmu nie widać. Kolejność dopasowania
      // (patrz MessageMapper): najpierw reguły dla konkretnego profilu (pole "profile"), potem reguły globalne
      // (bez pola "profile" = dotyczą wszystkich). W obrębie jednej reguły: najpierw "pattern" (wyrażenie
      // regularne, bez rozróżniania wielkości liter) – sprawdzany na DWÓCH wariantach znormalizowanego tekstu
      // OCR: zwykłym (litery A-Z/0-9, z podstawieniem typowych pomyłek OCR 0→O, 1→I – dobry dla SŁÓW, np.
      // "servo alarm") i "KeepDigits" (BEZ tego podstawienia – dla wzorców z cyframi; wystarczy dopasowanie
      // na KTÓRYMKOLWIEK wariancie). Potem "phrases" (dopasowanie rozmyte na zwykłym znormalizowanym tekście –
      // tolerancja "maxDistance" błędów odczytu OCR na całych słowach; frazy są słowami, nie numerami, więc
      // podstawienie 0/O i 1/I im nie szkodzi).
      //
      // UWAGA: czerwony tekst bywa DŁUŻSZY niż okienko statusu maszyny (HMI ucina go z obu stron, program
      // dokleja wtedy "…" do odczytu). Dlatego frazy opieraj na charakterystycznych słowach ze ŚRODKA
      // komunikatu, nie na jego początku/końcu. Nazwy ("shortText") trzymaj spójne z wpisami w "codes", bo
      // ten sam błąd może raz trafić po numerze, a raz (numer ucięty) po treści.
      "rules": [
        // Reguła IGNORUJĄCA (kategoria "nie błąd"): tekst dopasowany do niej to znany komunikat, który
        // błędem NIE jest – program nadal wykrywa czerwień po kolorze, ale taki odczyt nie może zostać
        // treścią alertu ani zakończyć prób OCR (patrz Config.Rule.IgnoredCategory, Ocr.MappedMessage.Ignored).
        {
          "id": "plan-wykonany-informacja",
          "pattern": "(ALL|AII|AI|A I|A II)\\s+PROCEDURES\\s+HAVE\\s+BEEN\\s+PROCESSED",
          "phrases": ["All procedures have been processed"],
          "maxDistance": 2,
          "shortText": "Plan produkcji wykonany (żółty komunikat – nie błąd)",
          "category": "nie błąd"
        },
        {
          "id": "servo-alarm",
          "pattern": "servo alarm",
          "shortText": "Servo – alarm",
          "category": "restart",
          "priority": 90
        },
        {
          "id": "servo-not-enabled",
          "pattern": "servo isn.?t enabled|servo not enabled",
          "shortText": "Servo niewłączone",
          "category": "restart",
          "priority": 80
        },
        {
          "id": "home-request",
          "pattern": "request home|home alarm|zero return",
          "shortText": "Bazowanie (Home)",
          "category": "restart",
          "priority": 50
        },
        {
          "id": "tray-grab",
          "phrases": ["Failed to grab a tray"],
          "shortText": "Tacka nie pobrana",
          "category": "tacka"
        },
        {
          "id": "tool-length",
          "phrases": ["tool length"],
          "shortText": "Długość narzędzia",
          "category": "narzedzie"
        },
        {
          "id": "tool-broken",
          "pattern": "tool broken|tool break",
          "shortText": "Złamane narzędzie",
          "category": "narzedzie"
        },
        {
          "id": "tool-setting-exceeds",
          "phrases": ["setting value exceeds error", "setting value exceeds"],
          "shortText": "Narzędzie – pomiar poza tolerancją",
          "category": "narzedzie",
          "priority": 65
        },
        {
